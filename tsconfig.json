{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "typeRoots": ["../hunk/node_modules/@types"],
    "types": ["bun", "react"],
    "baseUrl": ".",
    "paths": {
      "hunkdiff/extension": ["../hunk/packages/hunk/src/extension-api/index.ts"],
      "react": ["../hunk/node_modules/@types/react"],
      "react/*": ["../hunk/node_modules/@types/react/*"],
      "*": ["../hunk/node_modules/*", "../hunk/node_modules/@types/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["extension/**/*.ts", "extension/**/*.tsx"]
}

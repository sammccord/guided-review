{
  "name": "guided-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "guided-review is an agent skill with Hunk and native Cursor renderers that turn pull requests into ordered review tours.",
  "license": "MIT",
  "hunk": {
    "extensions": ["./extension/index.tsx"],
    "apiVersion": 25
  },
  "scripts": {
    "test": "bun test core extension cursor-extension/test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cursor-extension/tsconfig.json",
    "check": "bun run typecheck && bun run test",
    "demo": "examples/demo/run.sh",
    "build:cursor": "node cursor-extension/build.mjs",
    "package:cursor": "bun run build:cursor && cd cursor-extension && vsce package --no-dependencies",
    "demo:cursor": "examples/demo/run.sh --cursor",
    "test:cursor:smoke": "bun run build:cursor && node cursor-extension/test/run-smoke.mjs"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@types/bun": "1.4.1",
    "@types/react": "^19.2.14",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "hunkdiff": "^0.23.0",
    "react": "^19.2.4",
    "typescript": "^5.9.3"
  }
}
